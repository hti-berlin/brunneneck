# Brunneneck – statische Website auf IONOS

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Alte WordPress-Adressen auf die neuen Seiten
  RewriteRule ^impressum/?$ /impressum.html [L,R=301]
  RewriteRule ^datenschutz/?$ /datenschutz.html [L,R=301]
  RewriteRule ^wp-(admin|login\.php|content|includes)(/.*)?$ / [L,R=301]
</IfModule>

# Kurze Zwischenspeicherung für Seiten, längere für Bilder
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
